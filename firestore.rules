rules_version = '2';
// RNGWorld — Firestore security rules.
// Paste this whole file in Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admins are listed by the SHA-256 of their e-mail (lower case), so the address itself is never published.
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in ["077bbeed02568422d9e722f620a838fa9f254198fdec64f00b4ea677c80bed3c"];
    }
    // Day number (days since 1970) of the request, in UTC. The player's local day is always within ±1 of it.
    function today() { return math.floor(request.time.toMillis() / 86400000); }
    function player(uid) { return /databases/$(database)/documents/players/$(uid); }
    function claim(id) { return /databases/$(database)/documents/claims/$(id); }

    // Draws live on the account: draws = {day, n, t1, t2, t3}. Each draw adds one server timestamp (the city is
    // derived from it by the game), at most 3 per day; the day stays within a day of the server's date.
    // Collections only grow through a "keep": one city per draw day, the latest draw of that day, with the matching
    // claim written in the same transaction, in the player's name.
    function citiesUnchanged() {
      return request.resource.data.get('cities', []) == resource.data.get('cities', [])
        && request.resource.data.get('keepDay', -100) == resource.data.get('keepDay', -100);
    }
    function drawsUnchanged() {
      return request.resource.data.get('draws', null) == resource.data.get('draws', null);
    }
    function oneDraw() {
      let d0 = resource.data.get('draws', {'day': -100, 'n': 0});
      let d1 = request.resource.data.get('draws', {});
      let tk = 't' + string(d1.get('n', 0));
      return d1.get('day', null) is int && d1.get('n', null) is int
        && d1.day >= today() - 1 && d1.day <= today() + 1
        && (
          (d1.day == d0.day && d1.n == d0.n + 1 && d1.n <= 3
            && d1.keys().hasOnly(['day', 'n', 't1', 't2', 't3'])
            && d1.diff(d0).affectedKeys().hasOnly(['n', tk]))
          || (d1.day > d0.day && d1.n == 1 && d1.keys().hasOnly(['day', 'n', 't1']))
        )
        && d1[tk] == request.time;
    }
    function oneKeep() {
      let before = resource.data.get('cities', []);
      let after = request.resource.data.get('cities', []);
      let d = resource.data.get('draws', {'day': -100, 'n': 0});
      let kd = request.resource.data.get('keepDay', -1);
      let last = after[after.size() - 1];
      return after.size() == before.size() + 1
        && after[0:before.size()] == before
        && d.n >= 1
        && kd == d.day
        && kd > resource.data.get('keepDay', -100)
        && last.keys().hasOnly(['id', 't', 'at'])
        && last.at == d['t' + string(d.n)]
        && existsAfter(claim(string(last.id)))
        && getAfter(claim(string(last.id))).data.uid == request.auth.uid;
    }
    function validProfile() {
      return request.resource.data.size() < 40
        && (!('pseudo' in request.resource.data) || (request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 16))
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 60000));
    }

    // Players: everyone signed in can see profiles and collections (friends, leaderboards);
    // each player only writes their own document. Admins can reset collections.
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validProfile()
        && request.resource.data.get('cities', []).size() == 0
        && !('keepDay' in request.resource.data) && !('draws' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid && validProfile()
        && ((citiesUnchanged() && (drawsUnchanged() || oneDraw())) || (drawsUnchanged() && oneKeep()));
      allow update: if isAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Unique pseudos: one document per pseudo (lower case), owned by one player.
    match /pseudos/{pl} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && pl.matches('^[a-z0-9._-]{3,16}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // City locks: one document per kept city. Public to read, created once, never stolen.
    // Created only together with the keep on the player's document (same transaction).
    match /claims/{cityId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 't'])
        && getAfter(player(request.auth.uid)).data.get('keepDay', -100) >= today() - 1
        && string(getAfter(player(request.auth.uid)).data.cities[getAfter(player(request.auth.uid)).data.cities.size() - 1].id) == cityId;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Friend requests: id = fromUid__toUid. Only the two players involved see them.
    match /requests/{rid} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && rid == request.auth.uid + '__' + request.resource.data.to
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}
